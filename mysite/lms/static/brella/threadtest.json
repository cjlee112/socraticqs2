          "faq_id": 2,
          "ul_id": 3,
          "title": "Where did the 6,2, and 10 come from in the beginning of each probability?",
          "message": "I understand the fractions and where those probabilities came from but where did the 6s, 2s, and 10s come from?"
        },
        {
          "faq_id": 3,
          "ul_id": 3,
          "title": "Why did I think 266 was two hundred and sixty six?",
          "message": "I have a really important question and was wondering will you answer it?"
        }
      ],
      "faq_answers": [
        {
          "faq_id": 35,
          "ul_id": 3,
          "parent_id": 2,
          "title": "Another Great Insight from your Instructor",
          "message": "1/6 is the likelihood of any roll outcome under the F state. 1/2 is the likelihood of rolling a six under the L state.  1/10 is the likelihood of any other outcome (i.e. anything but a six) under the L state.  Note that the question explicitly asked you to calculate the joint probability of both the observed rolls and the hidden states (not JUST the hidden states)."
        },
        {
          "faq_id": 36,
          "ul_id": 3,
          "parent_id": 3,
          "title": "Help Is On The Way!",
          "message": "Sure thing, buddy."
        }
      ]
    },
